# 비워두면 로컬 파일(.data/)에 저장하고, 같은 브라우저 탭끼리만 함께 볼 수 있습니다.

# Supabase → Project Settings → API (Data API) 의 Project URL
SUPABASE_URL=
# 브라우저에 전달되는 공개 키 (anon 또는 publishable 키) — Realtime 채널용
SUPABASE_ANON_KEY=
# 서버 전용 비밀 키 (service_role 또는 secret 키) — 절대 공개하지 마세요
SUPABASE_SERVICE_ROLE_KEY=

# (선택) 시드 → 섬 id 해시에 섞는 값. 배포 후에는 바꾸지 마세요 (바꾸면 기존 섬을 못 찾습니다)
ISLAND_KEY_SALT=
